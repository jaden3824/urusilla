{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urusilla:evidence-log:quick60-discovery:1",
  "title": "Urusilla read-only evidence-log discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "log_id",
    "status",
    "log_epoch",
    "supported_tracks",
    "writes_enabled",
    "live_bot_enabled",
    "network_access_required",
    "submission_transport",
    "canonical_log_path",
    "canonical_log_sha256",
    "current_checkpoint_path",
    "current_checkpoint_sha256",
    "event_schema_path",
    "event_schema_sha256",
    "checkpoint_schema_path",
    "checkpoint_schema_sha256",
    "discovery_schema_path",
    "discovery_schema_sha256",
    "log_schema_path",
    "log_schema_sha256",
    "verifier_path",
    "verifier_sha256",
    "public_record_count",
    "discovery_sha256"
  ],
  "properties": {
    "schema_version": {"const": "urusilla-evidence-log-quick60-discovery/1"},
    "log_id": {"const": "urusilla-github-evidence-log"},
    "status": {"const": "empty-read-only"},
    "log_epoch": {"const": 1},
    "supported_tracks": {"const": ["quick_60s"]},
    "writes_enabled": {"const": false},
    "live_bot_enabled": {"const": false},
    "network_access_required": {"const": false},
    "submission_transport": {"type": "null"},
    "canonical_log_path": {"const": "epochs/00000001/log.json"},
    "canonical_log_sha256": {"$ref": "#/$defs/digest"},
    "current_checkpoint_path": {"const": "epochs/00000001/checkpoints/empty.json"},
    "current_checkpoint_sha256": {"$ref": "#/$defs/digest"},
    "event_schema_path": {"const": "schemas/event-v1.schema.json"},
    "event_schema_sha256": {"$ref": "#/$defs/digest"},
    "checkpoint_schema_path": {"const": "schemas/checkpoint-v1.schema.json"},
    "checkpoint_schema_sha256": {"$ref": "#/$defs/digest"},
    "discovery_schema_path": {"const": "schemas/discovery-v1.schema.json"},
    "discovery_schema_sha256": {"$ref": "#/$defs/digest"},
    "log_schema_path": {"const": "schemas/log-v1.schema.json"},
    "log_schema_sha256": {"$ref": "#/$defs/digest"},
    "verifier_path": {"const": "verify.py"},
    "verifier_sha256": {"$ref": "#/$defs/digest"},
    "public_record_count": {"const": 0},
    "discovery_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
