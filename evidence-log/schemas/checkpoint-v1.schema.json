{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urusilla:evidence-log:quick60-checkpoint:1",
  "title": "Urusilla evidence-log epoch-1 checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "log_id",
    "log_epoch",
    "tree_size",
    "first_sequence",
    "last_sequence",
    "head_record_sha256",
    "merkle_root_sha256",
    "log_sha256",
    "generated_at",
    "signature_status",
    "signer_id",
    "checkpoint_sha256"
  ],
  "properties": {
    "schema_version": {"const": "urusilla-evidence-log-quick60-checkpoint/1"},
    "log_id": {"const": "urusilla-github-evidence-log"},
    "log_epoch": {"const": 1},
    "tree_size": {"type": "integer", "minimum": 0, "maximum": 10000},
    "first_sequence": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "last_sequence": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "head_record_sha256": {"$ref": "#/$defs/nullableDigest"},
    "merkle_root_sha256": {"$ref": "#/$defs/nullableDigest"},
    "log_sha256": {"$ref": "#/$defs/digest"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "signature_status": {"const": "unsigned"},
    "signer_id": {"type": "null"},
    "checkpoint_sha256": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"tree_size": {"const": 0}}},
      "then": {
        "properties": {
          "first_sequence": {"type": "null"},
          "last_sequence": {"type": "null"},
          "head_record_sha256": {"type": "null"},
          "merkle_root_sha256": {"const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}
        }
      },
      "else": {
        "properties": {
          "first_sequence": {"const": 1},
          "last_sequence": {"type": "integer", "minimum": 1},
          "head_record_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}
  }
}
